{
  "dashboard": {
    "id": null,
    "title": "Planned Events API & PostgreSQL Monitoring",
    "tags": ["planned-events", "postgresql", "api"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Success Requests (2xx) - 1 min interval",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=~\".*2.*\"}[1m]))",
            "legendFormat": "Success Requests/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 10 },
                { "color": "red", "value": 50 }
              ]
            },
            "unit": "reqps"
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Failed Requests (4xx) - 1 min interval",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=~\".*4.*\"}[1m]))",
            "legendFormat": "Failed Requests/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            },
            "unit": "reqps"
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
      },
      {
        "id": 3,
        "title": "PostgreSQL Disk Space - 1 min interval",
        "type": "stat",
        "targets": [
          {
            "expr": "pg_database_size_bytes{database=\"cruise_db\"}",
            "legendFormat": "Database Size"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1073741824 },
                { "color": "red", "value": 5368709120 }
              ]
            },
            "unit": "bytes"
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
      },
      {
        "id": 4,
        "title": "PostgreSQL Disk Usage Percentage",
        "type": "stat",
        "targets": [
          {
            "expr": "(pg_database_size_bytes{database=\"cruise_db\"} / (pg_database_size_bytes{database=\"cruise_db\"} + 1)) * 100",
            "legendFormat": "Disk Usage %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 70 },
                { "color": "red", "value": 90 }
              ]
            },
            "unit": "percent"
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
      },
      {
        "id": 5,
        "title": "API Requests Over Time (1 min intervals)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=~\".*2.*\"}[1m]))",
            "legendFormat": "Success (2xx)"
          },
          {
            "expr": "sum(rate(http_requests_total{status=~\".*4.*\"}[1m]))",
            "legendFormat": "Failed (4xx)"
          },
          {
            "expr": "sum(rate(http_requests_total{status=~\".*5.*\"}[1m]))",
            "legendFormat": "Server Error (5xx)"
          }
        ],
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
      },
      {
        "id": 6,
        "title": "PostgreSQL Disk Space Over Time (1 min intervals)",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_database_size_bytes{database=\"cruise_db\"}",
            "legendFormat": "Database Size"
          }
        ],
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 }
      },
      {
        "id": 7,
        "title": "API Response Time (95th percentile)",
        "type": "stat",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))",
            "legendFormat": "95th percentile"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.5 },
                { "color": "red", "value": 1.0 }
              ]
            },
            "unit": "s"
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 }
      },
      {
        "id": 8,
        "title": "Total Requests by Endpoint",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[1m])) by (endpoint)",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "1m"
  }
}
